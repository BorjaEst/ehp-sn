	keywords = {Computer Science - Machine Learning, Computer Science - Artificial Intelligence},
	annotation = {Comment: 15 pages, 18 figures, 15 tables. Corresponding author: Michael Ivanitskiy (mivanits@mines.edu). Code available at https://github.com/understanding-search/structured-representations-maze-transformers},
	file = {Snapshot:C\:\\Users\\borja\\Zotero\\storage\\56PLHE2N\\2312.html:text/html},
}

@misc{cobbe_leveraging_2020,
	title = {Leveraging Procedural Generation to Benchmark Reinforcement Learning},
